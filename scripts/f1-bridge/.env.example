# Copie para scripts/f1-bridge/.env (já ignorado pelo Git) e preencha.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=coloque_a_anon_key_aqui

# Usuário DEDICADO ao bridge (Supabase > Authentication > Users > Add user)
BRIDGE_EMAIL=bridge@exemplo.com
BRIDGE_PASSWORD=troque-esta-senha

# Porta onde o jogo envia a telemetria (a mesma configurada no jogo)
UDP_PORT=20777

# Opcional: destino padrão do repasse para outro programa (SimHub, Aethernum...).
# O que você salvar no app (Ao Vivo › Repasse de pacotes) tem prioridade sobre este valor.
# Ex.: FORWARD_TO=127.0.0.1:20778   (vários: IP:porta,IP:porta)
# FORWARD_TO=

# Nome do canal Realtime. Use um nome difícil de adivinhar e o mesmo no app (VITE_LIVE_CHANNEL).
LIVE_CHANNEL=f1-live
# true = canal privado (exige policy em realtime.messages, veja README-AO-VIVO.md)
LIVE_PRIVATE=false
